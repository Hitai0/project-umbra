{
  "name": "ragnarok-hd2d-mmo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm --workspace=@mmo/server run dev\" \"npm --workspace=@mmo/client run dev\"",
    "dev:server": "npm --workspace=@mmo/server run dev",
    "dev:client": "npm --workspace=@mmo/client run dev",
    "build": "npm --workspaces run build",
    "clean": "node -e \"console.log('Cleaning...')\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
